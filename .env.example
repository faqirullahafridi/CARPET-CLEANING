# Required — PostgreSQL connection string (e.g. Neon, Supabase, or Vercel Postgres)
# Add this in Vercel → Project Settings → Environment Variables for Production.
# Tables are created automatically on deploy when DATABASE_URL is set.
DATABASE_URL=

# Optional — email notifications (bookings still work without SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# Set automatically by vercel.json for builds
PORT=4173
BASE_PATH=/
